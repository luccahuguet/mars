    "shell": {"kind": "table", "fields": {"program": {"kind": "string", "required": true}, "args": {"kind": "list", "items": "string", "default": []}}},
    "symbol-map": {"kind": "list", "items": {"kind": "table", "fields": {"start": {"kind": "string", "required": true}, "end": {"kind": "string", "required": true}, "font-family": {"kind": "string", "required": true}}}}
